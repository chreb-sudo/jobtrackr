generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Job {
  id           String    @id @default(cuid())
  company      String
  role         String
  link         String?
  notes        String?
  status       String    @default("Applied")
  order        Int       @default(0)
  followUpDate DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}
